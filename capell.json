{
    "manifest-version": 3,
    "name": "capell-app/exception-reports",
    "slug": "exception-reports",
    "displayName": "Exception Reports",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Emails the error, file and line when your Capell site hits an error it didn't handle, with an optional webhook for your own tools.",
    "product": {
        "group": "Capell Operations",
        "tier": "free",
        "bundle": "operations"
    },
    "namespace": "Capell\\ExceptionReports",
    "surfaces": ["console", "shared"],
    "dependencies": {
        "requires": ["capell-app/core"],
        "supports": ["capell-app/diagnostics"],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\ExceptionReports\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\ExceptionReports\\Providers\\ExceptionReportsServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "health-check",
            "class": "Capell\\ExceptionReports\\Health\\ExceptionReportsHealthCheck"
        },
        {
            "type": "console-command",
            "class": "Capell\\ExceptionReports\\Manifest\\ExceptionReportsConsoleCommandsContribution",
            "commands": ["capell:exception-reports-prune"],
            "commandClasses": [
                "Capell\\ExceptionReports\\Console\\Commands\\PruneExceptionReportsCommand"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\ExceptionReports\\Manifest\\ExceptionReportsPruneScheduleContribution",
            "command": "capell:exception-reports-prune",
            "name": "capell-exception-reports-prune",
            "frequency": "daily",
            "retentionDaysConfig": "capell-exception-reports.persistence.retention_days"
        },
        {
            "type": "migration",
            "class": "Capell\\ExceptionReports\\Manifest\\ExceptionReportsMigrationsContribution",
            "requiredTables": ["exception_reports"],
            "migrationFiles": [
                "2026_08_22_000001_create_exception_reports_table",
                "2026_09_29_120000_remove_implicit_timestamp_updates_from_exception_reports"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["exception_reports"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "prune": "capell:exception-reports-prune"
    },
    "actions": {
        "reportExceptionByEmail": "Capell\\ExceptionReports\\Actions\\ReportExceptionByEmailAction",
        "recordExceptionReport": "Capell\\ExceptionReports\\Actions\\RecordExceptionReportAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["transactional-email"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\ExceptionReports\\Actions\\RecordExceptionReportAction",
                "Capell\\ExceptionReports\\Actions\\ReportExceptionByEmailAction",
                "Capell\\ExceptionReports\\Support\\ExceptionReportMailSanitizer",
                "Capell\\ExceptionReports\\Support\\ExceptionReportMessage"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": false,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\ExceptionReports\\Actions\\SendExceptionReportWebhookAction"
            ]
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 0,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "exception-reports.runtime",
            "label": "Exception Reports registers sanitized email reporting for reported exceptions.",
            "class": "Capell\\ExceptionReports\\Health\\ExceptionReportsHealthCheck",
            "severity": "warning",
            "surface": "shared"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "standard",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "You hear about a crash in your inbox, often before a client tells you, and repeat errors are held back so one fault doesn't bury you.",
        "description": "Sends an email when your Capell site hits an error it didn't handle, naming the error, file, line and the page or command involved. By default it sends one email per identical error every 15 minutes and ten an hour in total, and a developer sets any other address and the optional webhook.",
        "problem": "The client told us the site was broken before we knew anything was wrong.",
        "outcome": "An email arrives naming the error, the file and line, and the app and page it came from.",
        "faq": [
            {
                "question": "Where do the emails go, and can I change that in the admin?",
                "answer": "They go to your site's sending address. The admin has no setting for it, so picking another address needs a developer."
            },
            {
                "question": "Is there a page where I can look back at past errors?",
                "answer": "No. There's no page of errors and no way to mark one resolved. Each exception is saved as a hidden record and deleted after 30 days by default, if your server's scheduler is running."
            },
            {
                "question": "Will one bad day fill my inbox?",
                "answer": "No. By default identical errors send one email every 15 minutes, and at most ten emails go out an hour. Anything held back is saved but not emailed."
            },
            {
                "question": "Do the emails include visitors' personal details?",
                "answer": "Not by default. Each email names the error, the file and line, the environment and the page or command. A developer can switch on the stack trace, the visitor's IP address and the signed-in person's identity."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-exception-email-preview.png",
                "alt": "Sample Exception Reports email showing the error, file and request details for a checkout failure",
                "caption": "A sample exception email names the error and where it occurred, with the request method, path and route."
            },
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Marketplace card titled Exception Reports with two abstract report windows beside a catch, sanitise and notify diagram",
                "caption": "The card that represents Exception Reports on its Marketplace listing."
            }
        ],
        "categories": ["operations", "monitoring", "email"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
